# Box API — get these from https://app.box.com/developers/console
BOX_CLIENT_ID=your_client_id_here
BOX_CLIENT_SECRET=your_client_secret_here
BOX_DEVELOPER_TOKEN=your_developer_token_here

# Apify — get from https://console.apify.com/account/integrations
APIFY_API_KEY=your_apify_api_key_here

# Toggle mocks (set to "false" once Person A/B hand off their modules)
USE_MOCK_SCRAPER=true
USE_MOCK_AGENT=true
